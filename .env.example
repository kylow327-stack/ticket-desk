# Copy to a gitignored .env only if you need file-based config.
# Prefer exporting DEEPSEEK_API_KEY in the shell. Never commit a real key.
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# Optional overrides
# TICKET_AGENT_DATA=./data
# TICKET_AGENT_MAX_STEPS=5
# TICKET_AGENT_HOST=127.0.0.1
# TICKET_AGENT_PORT=8000

# Optional LangSmith tracing and evals. Leave these commented to keep traces local (JSONL only).
# Organisation-scoped service keys also need LANGSMITH_WORKSPACE_ID (LangSmith Settings → General)
# unless the key can see exactly one workspace, which is resolved automatically.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=ticket-desk
# LANGSMITH_WORKSPACE_ID=
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
