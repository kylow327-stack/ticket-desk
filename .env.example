# Copy to a gitignored .env only if you need file-based config.
# Prefer exporting DEEPSEEK_API_KEY in the shell. Never commit a real key.
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# Optional overrides
# TICKET_AGENT_DATA=./data
# TICKET_AGENT_MAX_STEPS=5
# TICKET_AGENT_HOST=127.0.0.1
# TICKET_AGENT_PORT=8000
